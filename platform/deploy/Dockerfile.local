FROM golang:1.27-alpine AS backend
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -buildvcs=false -o /server ./cmd/server

FROM node:22-alpine AS frontend
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
COPY scripts/check-budget.mjs /src/scripts/check-budget.mjs
RUN npm run build

FROM alpine:3.23 AS api
WORKDIR /app
COPY --from=backend /server ./server
COPY migrations ./migrations
COPY fixtures/demo ./fixtures/demo
CMD ["sh", "-c", "./server migrate && ./server seed-demo && exec ./server"]

FROM nginx:alpine AS web
COPY --from=frontend /src/web/dist /usr/share/nginx/html
COPY deploy/nginx.local.conf /etc/nginx/conf.d/default.conf
